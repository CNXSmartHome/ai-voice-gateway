# Normalize line endings so Windows, macOS, and Linux checkouts agree with
# .editorconfig and so shell scripts in CI stay executable.
* text=auto eol=lf

# Explicitly text
*.ts    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.csv   text eol=lf
*.sh    text eol=lf

# Firmware sources (ESP-IDF)
*.c     text eol=lf
*.h     text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
*.bin   binary
*.elf   binary

# Generated: collapse in diffs and exclude from language stats
package-lock.json linguist-generated=true
