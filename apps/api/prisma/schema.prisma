// AI Voice Gateway core schema.
//
// Models the hierarchy in docs/DEVICE_MODEL.md:
//   Organization -> Property -> Room -> Gateway / Device
//
// Enum values here are the storage representation. They are mapped to the
// canonical lowercase values in packages/domain by apps/api/src/database/
// domain-mapping.ts, and a drift test asserts the two stay in step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Top of the ownership hierarchy. An integrator or a home owner.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties  Property[]
  memberships Membership[]

  @@map("organizations")
}

/// A person who signs in to the API (VG-004).
///
/// A user is not itself an owner of anything: ownership flows through
/// `Membership`, so the hierarchy above keeps its single root.
model User {
  id String @id @default(cuid())
  /// Normalized to lower case before storage, so uniqueness is not
  /// case-sensitive. The database enforces this on the normalized value.
  email String @unique
  /// Salted hash only. See src/auth/password.service.ts for the encoding;
  /// the plaintext is never stored, logged, or returned.
  passwordHash String     @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships          Membership[]
  serviceRequests      ServiceRequest[]      @relation("ServiceRequestCreator")
  serviceRequestEvents ServiceRequestEvent[] @relation("ServiceRequestEventActor")

  @@map("users")
}

/// A user's membership of an organization, and their role in it.
///
/// Modelled as its own table rather than a column on `User` so a user can
/// belong to more than one organization — an integrator managing several
/// clients is a primary MVP user in docs/PRODUCT.md.
model Membership {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  organizationId String         @map("organization_id")
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// A user holds exactly one role in a given organization.
  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

/// A villa, home, or building belonging to an organization.
model Property {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  timezone       String   @default("UTC")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms           Room[]
  gateways        Gateway[]
  devices         Device[]
  serviceRequests ServiceRequest[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("properties")
}

/// A room within a property. Supplies the voice context: a gateway's room is
/// what resolves "turn on the light" to a specific device.
model Room {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property        Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  gateways        Gateway[]
  devices         Device[]
  serviceRequests ServiceRequest[]

  @@unique([propertyId, name])
  @@index([propertyId])
  @@map("rooms")
}

/// A VG-100/SVC-Voice voice gateway.
///
/// Holds no device data: it is an authenticated audio and transport endpoint
/// (docs/ARCHITECTURE.md). Its value to the AI is the room it sits in.
model Gateway {
  id              String        @id @default(cuid())
  propertyId      String?       @map("property_id")
  roomId          String?       @map("room_id")
  serialNumber    String        @unique @map("serial_number")
  name            String
  status          GatewayStatus @default(UNCLAIMED)
  firmwareVersion String?       @map("firmware_version")
  lastSeenAt      DateTime?     @map("last_seen_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  property        Property?        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room            Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  serviceRequests ServiceRequest[] @relation("ServiceRequestGateway")

  @@index([propertyId])
  @@index([roomId])
  @@map("gateways")
}

/// A controllable device, normalized away from its source platform.
model Device {
  id           String       @id @default(cuid())
  propertyId   String       @map("property_id")
  roomId       String?      @map("room_id")
  name         String
  type         DeviceType
  platform     Platform
  externalId   String       @map("external_id")
  capabilities Capability[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([propertyId, platform, externalId])
  @@index([propertyId])
  @@index([roomId])
  @@map("devices")
}

/// A hospitality request shared by guest web, voice, staff and automations.
/// PostgreSQL is authoritative; realtime delivery is a projection of this state.
model ServiceRequest {
  id              String               @id @default(cuid())
  publicId        String               @unique @map("public_id")
  propertyId      String               @map("property_id")
  roomId          String?              @map("room_id")
  sourceGatewayId String?              @map("source_gateway_id")
  createdByUserId String?              @map("created_by_user_id")
  source          ServiceRequestSource
  status          ServiceRequestStatus @default(NEW)
  category        String
  note            String?
  idempotencyKey  String?              @map("idempotency_key")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  completedAt     DateTime?            @map("completed_at")

  property      Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room          Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  sourceGateway Gateway?              @relation("ServiceRequestGateway", fields: [sourceGatewayId], references: [id], onDelete: SetNull)
  createdByUser User?                 @relation("ServiceRequestCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  items         ServiceRequestItem[]
  events        ServiceRequestEvent[]

  @@unique([propertyId, idempotencyKey])
  @@index([propertyId, status, createdAt])
  @@index([roomId])
  @@index([sourceGatewayId])
  @@map("service_requests")
}

model ServiceRequestItem {
  id        String @id @default(cuid())
  requestId String @map("request_id")
  sku       String
  name      String?
  quantity  Int

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("service_request_items")
}

/// Immutable lifecycle history for a service request.
model ServiceRequestEvent {
  id          String               @id @default(cuid())
  requestId   String               @map("request_id")
  fromStatus  ServiceRequestStatus? @map("from_status")
  toStatus    ServiceRequestStatus  @map("to_status")
  actorUserId String?              @map("actor_user_id")
  createdAt   DateTime             @default(now()) @map("created_at")

  request   ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actorUser User?          @relation("ServiceRequestEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@map("service_request_events")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER

  @@map("membership_role")
}

enum GatewayStatus {
  UNCLAIMED
  ONLINE
  OFFLINE
  DISABLED

  @@map("gateway_status")
}

enum DeviceType {
  LIGHT
  CLIMATE
  CURTAIN
  SWITCH
  SCENE

  @@map("device_type")
}

enum Platform {
  TUYA

  @@map("platform")
}

enum Capability {
  POWER
  BRIGHTNESS
  COLOR_TEMPERATURE
  RGB
  TARGET_TEMPERATURE
  CURRENT_TEMPERATURE
  HVAC_MODE
  FAN_SPEED
  POSITION
  OPEN
  CLOSE
  STOP
  EXECUTE

  @@map("capability")
}

enum ServiceRequestSource {
  GUEST_WEB
  VOICE
  STAFF
  ADMIN
  AUTOMATION

  @@map("service_request_source")
}

enum ServiceRequestStatus {
  NEW
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED

  @@map("service_request_status")
}
