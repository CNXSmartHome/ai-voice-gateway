// AI Voice Gateway core schema.
//
// Models the hierarchy in docs/DEVICE_MODEL.md:
//   Organization -> Property -> Room -> Gateway / Device
//
// Enum values here are the storage representation. They are mapped to the
// canonical lowercase values in packages/domain by apps/api/src/database/
// domain-mapping.ts, and a drift test asserts the two stay in step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Top of the ownership hierarchy. An integrator or a home owner.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  properties  Property[]
  memberships Membership[]

  @@map("organizations")
}

/// A person who signs in to the API (VG-004).
///
/// A user is not itself an owner of anything: ownership flows through
/// `Membership`, so the hierarchy above keeps its single root.
model User {
  id String @id @default(cuid())
  /// Normalized to lower case before storage, so uniqueness is not
  /// case-sensitive. The database enforces this on the normalized value.
  email String @unique
  /// Salted hash only. See src/auth/password.service.ts for the encoding;
  /// the plaintext is never stored, logged, or returned.
  passwordHash String    @map("password_hash")
  name         String
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  memberships Membership[]

  @@map("users")
}

/// A user's membership of an organization, and their role in it.
///
/// Modelled as its own table rather than a column on `User` so a user can
/// belong to more than one organization — an integrator managing several
/// clients is a primary MVP user in docs/PRODUCT.md.
model Membership {
  id             String         @id @default(cuid())
  userId         String         @map("user_id")
  organizationId String         @map("organization_id")
  role           MembershipRole @default(MEMBER)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// A user holds exactly one role in a given organization.
  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("memberships")
}

/// A villa, home, or building belonging to an organization.
model Property {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  timezone       String   @default("UTC")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rooms        Room[]
  gateways     Gateway[]
  devices      Device[]
  resources    Resource[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("properties")
}

/// A room within a property. Supplies the voice context: a gateway's room is
/// what resolves "turn on the light" to a specific device.
model Room {
  id         String   @id @default(cuid())
  propertyId String   @map("property_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  property  Property   @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  gateways  Gateway[]
  devices   Device[]
  resources Resource[]

  @@unique([propertyId, name])
  @@index([propertyId])
  @@map("rooms")
}

/// A VG-100 voice gateway.
///
/// Holds no device data: it is an authenticated audio and transport endpoint
/// (docs/ARCHITECTURE.md). Its value to the AI is the room it sits in.
///
/// A gateway exists from manufacture, before anyone owns it. The pre-claim
/// state is `status = UNCLAIMED` with `property_id = NULL`; claiming (VG-005)
/// assigns the property on the existing row, keyed by serial number, so the
/// hardware identity is never recreated.
model Gateway {
  id              String        @id @default(cuid())
  /// Null until the gateway is claimed into a property (VG-005).
  propertyId      String?       @map("property_id")
  /// Null until the gateway is assigned to a room.
  roomId          String?       @map("room_id")
  /// Hardware identity, set at manufacture. Used to claim the device.
  serialNumber    String        @unique @map("serial_number")
  name            String
  status          GatewayStatus @default(UNCLAIMED)
  /// Reported by the device, used for OTA decisions (VG-030).
  firmwareVersion String?       @map("firmware_version")
  /// Updated by the heartbeat (VG-006); null when never connected.
  lastSeenAt      DateTime?     @map("last_seen_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Cascades only once claimed: an unclaimed gateway holds no property, so no
  // property delete can reach a hardware identity nobody owns yet.
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // A room may be deleted while a gateway survives, unassigned.
  room     Room?     @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([roomId])
  @@map("gateways")
}

/// A controllable device, normalized away from its source platform.
///
/// `capabilities` holds canonical values only. Provider-specific names are
/// normalized in the adapter layer before a row is written here.
model Device {
  id           String       @id @default(cuid())
  propertyId   String       @map("property_id")
  /// Null until assigned to a room (VG-013).
  roomId       String?      @map("room_id")
  name         String
  type         DeviceType
  platform     Platform
  /// Identifier on the source platform. Meaningful only to that adapter.
  externalId   String       @map("external_id")
  capabilities Capability[]
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)

  /// The same provider device cannot be imported into one property twice.
  @@unique([propertyId, platform, externalId])
  @@index([propertyId])
  @@index([roomId])
  @@map("devices")
}

/// A controllable thing, addressed without reference to the platform it lives
/// on (VG-040).
///
/// `Device` records what an adapter imported: a row per provider device, keyed
/// by the provider's own identifier. `Resource` records what the system is
/// willing to act on and who may act on it. They are separate because the two
/// answer different questions, and because the control pipeline must be able
/// to refuse -- a disabled resource, a resource in another villa -- without
/// that refusal depending on what any provider currently reports.
///
/// In Smart Villa terms `property_id` is the villa and `room_id` is the zone.
/// No `Villa` or `Zone` table exists: docs/DEVICE_MODEL.md roots everything in
/// Organization -> Property -> Room, and a second hierarchy alongside it would
/// be a second answer to "who owns this".
model Resource {
  id           String       @id @default(cuid())
  propertyId   String       @map("property_id")
  /// Null until assigned to a zone. A resource with no zone is still
  /// controllable by name, it just cannot be resolved by room context.
  roomId       String?      @map("room_id")
  name         String
  kind         DeviceType
  capabilities Capability[]
  /// Whether the control pipeline will act on this resource.
  ///
  /// A column rather than a deletion so that taking something out of service
  /// is reversible and auditable, and so a resolver can distinguish "no such
  /// resource" from "that one is switched off" -- which are different answers
  /// to the caller even though both refuse the command.
  enabled      Boolean      @default(true)
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  property Property         @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  room     Room?            @relation(fields: [roomId], references: [id], onDelete: SetNull)
  binding  ResourceBinding?

  /// Two resources of the same kind and name in one zone cannot be told apart
  /// by anything a caller says, so the resolver could never choose between
  /// them. Rejecting the second at write time turns an unanswerable runtime
  /// ambiguity into an error at the point someone can still fix it.
  ///
  /// This covers resources that have a zone. It does NOT cover unassigned
  /// ones: PostgreSQL treats NULLs as distinct, so two rows with a null
  /// `room_id` and the same property, kind, and name both satisfy it. The
  /// migration adds a partial unique index over
  /// (property_id, kind, name) WHERE room_id IS NULL for that half, because
  /// Prisma cannot express a partial index or NULLS NOT DISTINCT here.
  ///
  /// Do not remove that index. It is not represented in this file, so
  /// `prisma migrate dev` will offer to drop it;
  /// `prisma-schema-contract.spec.ts` fails if it goes.
  @@unique([propertyId, roomId, kind, name])
  @@index([propertyId])
  @@index([roomId])
  @@map("resources")
}

/// Where a resource actually lives: a platform and that platform's own
/// identifier for it.
///
/// Held in its own table rather than as columns on `Resource` so that the
/// provider identifier is something a query has to ask for. The public views
/// in `apps/api/src/resources/resource.view.ts` never select this relation, so
/// a field added here cannot reach a client by being forgotten about --
/// the same reasoning as `GATEWAY_SELECT`.
model ResourceBinding {
  id         String   @id @default(cuid())
  resourceId String   @unique @map("resource_id")
  /// Denormalized from the resource so the uniqueness constraint below can be
  /// scoped to one villa. The registry writes both in one transaction and
  /// asserts they agree; nothing else writes this table.
  propertyId String   @map("property_id")
  platform   Platform
  /// Identifier on the source platform. Meaningful only to that adapter.
  externalId String   @map("external_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  /// Scoped to the property, not global. Home Assistant entity ids such as
  /// `light.kitchen` are unique only within one installation, so a global
  /// constraint would stop a second villa from ever binding its own kitchen
  /// light.
  @@unique([propertyId, platform, externalId])
  @@index([propertyId])
  @@map("resource_bindings")
}

enum UserStatus {
  ACTIVE
  /// Retained for audit and referential integrity, but cannot sign in.
  DISABLED

  @@map("user_status")
}

enum MembershipRole {
  /// Created the organization. Cannot be removed by another member.
  OWNER
  ADMIN
  MEMBER

  @@map("membership_role")
}

enum GatewayStatus {
  /// Manufactured and known, not yet claimed by an account.
  UNCLAIMED
  /// Claimed and provisioned, currently connected.
  ONLINE
  /// Claimed, not currently connected.
  OFFLINE
  /// Administratively taken out of service.
  DISABLED

  @@map("gateway_status")
}

enum DeviceType {
  LIGHT
  CLIMATE
  CURTAIN
  SWITCH
  SCENE

  @@map("device_type")
}

enum Platform {
  TUYA
  /// Present so provider independence is testable with more than one
  /// platform (VG-040). The adapter registered under it is a stub.
  HOME_ASSISTANT

  @@map("platform")
}

enum Capability {
  // common
  POWER
  // light
  BRIGHTNESS
  COLOR_TEMPERATURE
  RGB
  // climate
  TARGET_TEMPERATURE
  CURRENT_TEMPERATURE
  HVAC_MODE
  FAN_SPEED
  // curtain
  POSITION
  OPEN
  CLOSE
  STOP
  // scene
  EXECUTE

  @@map("capability")
}
