{
  "name": "@vg/api",
  "version": "0.1.0",
  "private": true,
  "description": "AI Voice Gateway cloud API service",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "prisma:generate": "node scripts/prisma-generate.js",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "build": "npm run prisma:generate && tsc -b tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.test.json --noEmit",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run prisma:generate && jest --config jest.config.js",
    "test:integration": "npm run prisma:generate && jest --config jest.integration.config.js",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.3",
    "@prisma/client": "6.12.0",
    "@vg/domain": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.3",
    "@types/express": "^5.0.6",
    "@types/supertest": "^6.0.2",
    "prisma": "6.12.0",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2"
  }
}
