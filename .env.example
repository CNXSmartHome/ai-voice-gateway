# AI Voice Gateway - environment variable NAMES only.
# Never commit real values. Secrets live in GitHub Actions Secrets or a
# cloud secret manager (see AI_GOVERNANCE.md - Secrets policy).

# --- Runtime ---
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=debug

# --- Datastores (VG-003) ---
DATABASE_URL=
REDIS_URL=

# --- Authentication (VG-004) ---
JWT_SECRET=
JWT_ISSUER=
JWT_ACCESS_TTL_SECONDS=

# --- Gateway transport (VG-005, VG-006) ---
GATEWAY_WS_PATH=/v1/gateway/session
GATEWAY_HEARTBEAT_INTERVAL_SECONDS=

# --- Tuya integration (VG-010) ---
# Cloud-side only. These must never be provisioned to a gateway device.
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_REGION=

# --- Realtime AI (VG-019) ---
AI_PROVIDER_API_KEY=
AI_REALTIME_MODEL=
