# AI Voice Gateway - environment variable NAMES only.
# Never commit real values. Secrets live in GitHub Actions Secrets or a
# cloud secret manager (see AI_GOVERNANCE.md - Secrets policy).

# --- Runtime ---
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
LOG_LEVEL=debug

# --- Datastores ---
# PostgreSQL connection string (VG-003). Required to run the API and the
# database integration tests. With the bundled compose file:
#   DATABASE_URL=postgresql://vg:vg@127.0.0.1:5432/vg_dev?schema=public
DATABASE_URL=

# Redis is not used yet; no MVP task depends on it.
REDIS_URL=

# --- Authentication (VG-004) ---
# Signing key for access tokens. Required in production, where the API
# refuses to start without at least 32 characters. Left blank outside
# production, a random one is generated per process: convenient for local
# work, and it cannot be mistaken for a real secret or survive a restart.
JWT_SECRET=
# Token issuer claim. Defaults to "ai-voice-gateway".
JWT_ISSUER=
# Access token lifetime. Defaults to 3600 (one hour). There is no refresh
# token yet, so this is how long a client works before signing in again.
JWT_ACCESS_TTL_SECONDS=

# --- Gateway transport (VG-005, VG-006) ---
# Path the gateway session upgrades on. Defaults to /v1/gateway/session.
GATEWAY_WS_PATH=/v1/gateway/session
# How often the server pings an idle gateway connection. Defaults to 30.
# A connection that misses two pings is closed and the gateway marked
# OFFLINE, so a device that loses power does not read ONLINE forever.
GATEWAY_HEARTBEAT_INTERVAL_SECONDS=
# Device secrets are NOT configured here. Each gateway gets its own at
# manufacture (scripts/register-gateway.js), and only the hash is stored.

# --- Tuya integration (VG-010) ---
# Cloud-side only. These must never be provisioned to a gateway device.
TUYA_CLIENT_ID=
TUYA_CLIENT_SECRET=
TUYA_REGION=

# --- Realtime AI (VG-019) ---
AI_PROVIDER_API_KEY=
AI_REALTIME_MODEL=
